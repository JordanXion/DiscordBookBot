# Discord application bot token
DISCORD_TOKEN=

# Hardcover API token (https://hardcover.app account settings -> API)
HARDCOVER_TOKEN=

# Optional: guild id for instant slash-command sync while developing.
# Leave blank in production so commands register globally.
DEV_GUILD_ID=

# Path to the SQLite database file
DB_PATH=data/bookbot.db

LOG_LEVEL=INFO
