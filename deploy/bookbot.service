[Unit]
Description=Discord Book Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bookbot
Group=bookbot
WorkingDirectory=/opt/discord-book-bot
EnvironmentFile=/etc/discord-book-bot.env
ExecStart=/opt/discord-book-bot/.venv/bin/python -m src
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/discord-book-bot/data

[Install]
WantedBy=multi-user.target
